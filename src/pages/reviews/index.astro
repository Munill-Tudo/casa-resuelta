---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/articles';
import { buyerProfileLabel } from '../../data/products';
const products = [...new Map(articles.flatMap(a => a.products.map(p => [p.name, { ...p, article: a }]))).values()].slice(0, 24);
---
<BaseLayout title="Productos" description="Productos incluidos en las guías de Con Buen Ojo.">
<section class="category-hero"><div class="container"><span class="eyebrow">Productos de las guías</span><h1>Productos incluidos y criterios de compra</h1><p class="lead">Consulta los modelos mencionados en nuestras guías, con su uso orientativo, punto fuerte y limitación principal antes de comprar.</p></div></section>
<section class="section"><div class="container grid grid-3">{products.map(p => <a class="card card-link" href={`/${p.article.category}/${p.article.slug}/`}><span class="pill">{p.article.type}</span><h3>{p.name}</h3><p><strong>Orientado a:</strong> {buyerProfileLabel(p.bestFor)}. {p.strength}</p></a>)}</div></section>
</BaseLayout>
